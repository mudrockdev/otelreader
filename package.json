{
	"name": "otelreader",
	"version": "0.0.1",
	"description": "A terminal viewer for OpenTelemetry traces, with a built-in OTLP/HTTP receiver",
	"license": "GPL-3.0-or-later",
	"author": "Ufuk Furkan Öztürk",
	"keywords": [
		"opentelemetry",
		"otel",
		"otlp",
		"tracing",
		"traces",
		"tui",
		"terminal",
		"cli",
		"bun"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mudrockdev/otelreader.git"
	},
	"homepage": "https://github.com/mudrockdev/otelreader#readme",
	"bugs": "https://github.com/mudrockdev/otelreader/issues",
	"type": "module",
	"bin": {
		"otelreader": "dist/otelreader.js"
	},
	"files": [
		"dist/otelreader.js"
	],
	"engines": {
		"bun": ">=1.4.5"
	},
	"packageManager": "bun@1.4.5",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"start": "bun src/main.ts",
		"test": "bun test",
		"format": "bun format --write .",
		"build:windows": "bun build.ts windows",
		"build:linux": "bun build.ts linux",
		"build:darwin": "bun build.ts darwin",
		"build:npm": "bun build.ts npm",
		"prepublishOnly": "bun run test && bun run build:npm"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/otlp-transformer": "^0.301.2",
		"@opentelemetry/resources": "^3.1.1",
		"@opentelemetry/sdk-trace": "^3.1.1",
		"@types/bun": "^1.4.5",
		"mudui": "^0.1.0",
		"svelte": "^5.59.0"
	}
}
